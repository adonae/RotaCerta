{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rotacerta",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rotacerta",
      // Substitua pelo ID retornado por: npx wrangler d1 create rotacerta
      "database_id": "cd29619a-20b4-431a-863b-663bc3ba8389",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "PHOTOS",
      "id": "24701b0eda3c4573bf14fafe9bd7ad63"
    }
  ],
  "observability": {
    "enabled": true
  }
}
